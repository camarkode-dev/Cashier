# Database (Supabase)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# App
NODE_ENV="production"
FRONTEND_URL="https://your-domain.vercel.app"
API_URL="https://your-domain.vercel.app/api"
NEXT_PUBLIC_API_URL="https://your-domain.vercel.app/api"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Security
JWT_SECRET="strong-random-key"
JWT_REFRESH_SECRET="strong-random-key"

# Superadmin
SUPERADMIN_EMAIL="admin@yourapp.com"
SUPERADMIN_PASSWORD="VeryStrongPassword!123"

# App Name
NEXT_PUBLIC_APP_NAME="أولاد أيمن للأدوات المنزلية"

# Rate Limit
THROTTLE_TTL=60
THROTTLE_LIMIT=100