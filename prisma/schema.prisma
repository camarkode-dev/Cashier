generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  ADMIN
  CASHIER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  QR
  SPLIT
  CREDIT
}

enum StockTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  STOCK_TRANSFER
  NEW_SALE
  SYSTEM
  INFO
}

// ─── Tenant ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id
  name      String
  nameAr    String?
  slug      String   @unique
  email     String
  phone     String?
  currency  String   @default("EGP")
  taxRate   Float    @default(0)
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  branches        Branch[]
  license         License?
  invoiceSettings InvoiceSettings?

  @@index([slug])
}

model License {
  id          String    @id @default(cuid())
  tenantId    String?   @unique
  key         String    @unique
  type        String    @default("BASIC")
  status      String    @default("ACTIVE")
  maxDevices  Int       @default(2)
  maxUsers    Int       @default(3)
  maxBranches Int       @default(1)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

model InvoiceSettings {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  logoUrl       String?
  footerNote    String?
  footerNoteAr  String?
  showTaxNumber Boolean @default(false)
  taxNumber     String?
  showLogo      Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─── Users ──────────────────────────────────────────────────────────────────

model User {
  id        String   @id // Matches Supabase auth.users.id
  email     String   @unique
  password  String?
  firstName String
  lastName  String
  role      UserRole @default(CASHIER)
  isActive  Boolean  @default(true)
  tenantId  String?
  branchId  String?
  avatarUrl String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant?        @relation(fields: [tenantId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  sales         Sale[]
  auditLogs     AuditLog[]
  transfersMade StockTransfer[]
  notifications Notification[]

  @@index([role])
  @@index([branchId])
  @@index([tenantId])
}

// ─── Branches ───────────────────────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  tenantId  String?
  name      String
  nameAr    String?
  address   String?
  phone     String?
  isMain    Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  users         User[]
  inventory     Inventory[]
  sales         Sale[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")

  @@index([isMain])
  @@index([tenantId])
}

// ─── Categories ─────────────────────────────────────────────────────────────

model Category {
  id     String    @id @default(cuid())
  name   String
  nameAr String?
  color  String?
  icon   String?

  products Product[]
}

// ─── Products ───────────────────────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  nameAr      String?
  sku         String?  @unique
  barcode     String?  @unique
  qrCode      String?
  price       Float
  costPrice   Float    @default(0)
  taxRate     Float    @default(0)
  categoryId  String?
  image       String?
  description String?
  isActive    Boolean  @default(true)
  minStock    Int      @default(5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category      Category?          @relation(fields: [categoryId], references: [id])
  inventory     Inventory[]
  saleItems     SaleItem[]
  transferItems StockTransferItem[]

  @@index([barcode])
  @@index([categoryId])
  @@index([isActive])
}

// ─── Inventory ──────────────────────────────────────────────────────────────

model Inventory {
  id       String @id @default(cuid())
  productId String
  branchId  String
  quantity  Int    @default(0)
  minStock  Int    @default(5)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
}

// ─── Customers ──────────────────────────────────────────────────────────────

model Customer {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  email         String?
  phone         String?  @unique
  address       String?
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sales Sale[]

  @@index([phone])
}

// ─── Sales ──────────────────────────────────────────────────────────────────

model Sale {
  id             String        @id @default(cuid())
  invoiceNumber  String        @unique
  offlineId      String?       @unique
  branchId       String
  userId         String
  customerId     String?
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CASH)
  subtotal       Float
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  total          Float
  profit         Float         @default(0)
  paidAmount     Float         @default(0)
  changeAmount   Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  items    SaleItem[]

  @@index([branchId, createdAt])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model SaleItem {
  id             String @id @default(cuid())
  saleId         String
  productId      String
  name           String
  nameAr         String?
  barcode        String?
  quantity       Int
  unitPrice      Float
  costPrice      Float  @default(0)
  discountAmount Float  @default(0)
  discountPercent Float @default(0)
  taxRate        Float  @default(0)
  taxAmount      Float  @default(0)
  total          Float
  profit         Float  @default(0)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

// ─── Stock Transfers ────────────────────────────────────────────────────────

model StockTransfer {
  id           String              @id @default(cuid())
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(COMPLETED)
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  createdBy  User                @relation(fields: [createdById], references: [id])
  items      StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([createdAt])
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  productId       String
  quantity        Int
  costPrice       Float         @default(0)

  stockTransfer StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([stockTransferId])
}

// ─── Expenses ───────────────────────────────────────────────────────────────

model Expense {
  id            String   @id @default(cuid())
  branchId      String?
  title         String
  titleAr       String?
  amount        Float
  category      String
  paymentMethod String   @default("CASH")
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([branchId])
}

// ─── Suppliers ──────────────────────────────────────────────────────────────

model Supplier {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType @default(INFO)
  title     String
  titleAr   String?
  message   String
  messageAr String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─── Audit Logs ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // product, sale, user, stock_transfer, etc.
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
