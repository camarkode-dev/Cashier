generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Sale {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique
  offlineId      String?       @unique
  branchId       String
  userId         String
  customerId     String?
  status         SaleStatus    @default(COMPLETED)
  paymentMethod  PaymentMethod @default(CASH)
  subtotal       Float
  discountAmount Float         @default(0)
  taxAmount      Float         @default(0)
  total          Float
  profit         Float         @default(0)
  paidAmount     Float         @default(0)
  changeAmount   Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  branch         Branch        @relation(fields: [branchId], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  items          SaleItem[]
  payments       Payment[]

  @@index([branchId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

model Tenant {
  id              String           @id
  name            String
  nameAr          String?
  slug            String           @unique
  email           String
  phone           String?
  currency        String           @default("SAR")
  taxRate         Float            @default(0)
  logo            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  branches        Branch[]
  invoiceSettings InvoiceSettings?
  license         License?
  users           User[]

  @@index([slug])
}

model License {
  id          String    @id @default(cuid())
  tenantId    String?   @unique
  key         String    @unique
  type        String    @default("BASIC")
  status      String    @default("ACTIVE")
  maxDevices  Int       @default(2)
  maxUsers    Int       @default(3)
  maxBranches Int       @default(1)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
}

model InvoiceSettings {
  id            String  @id @default(cuid())
  tenantId      String  @unique
  logoUrl       String?
  footerNote    String?
  footerNoteAr  String?
  showTaxNumber Boolean @default(false)
  taxNumber     String?
  showLogo      Boolean @default(true)
  tenant        Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id            String          @id
  email         String          @unique
  password      String?
  firstName     String
  lastName      String
  role          UserRole        @default(CASHIER)
  isActive      Boolean         @default(true)
  tenantId      String?
  branchId      String?
  avatarUrl     String?
  phone         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  auditLogs     AuditLog[]
  notifications Notification[]
  sales         Sale[]
  transfersMade StockTransfer[]
  branch        Branch?         @relation(fields: [branchId], references: [id])
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])

  @@index([branchId])
  @@index([tenantId])
  @@index([role])
}

model Branch {
  id            String          @id @default(cuid())
  tenantId      String?
  name          String
  nameAr        String?
  address       String?
  phone         String?
  isMain        Boolean         @default(false)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  tenant        Tenant?         @relation(fields: [tenantId], references: [id])
  inventory     Inventory[]
  sales         Sale[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  users         User[]

  @@index([isMain])
  @@index([tenantId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  nameAr   String?
  color    String?
  icon     String?
  products Product[]
}

model Product {
  id            String              @id @default(cuid())
  name          String
  nameAr        String?
  sku           String?             @unique
  barcode       String?             @unique
  qrCode        String?
  price         Float
  costPrice     Float               @default(0)
  taxRate       Float               @default(0)
  categoryId    String?
  image         String?
  description   String?
  isActive      Boolean             @default(true)
  minStock      Int                 @default(5)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  inventory     Inventory[]
  category      Category?           @relation(fields: [categoryId], references: [id])
  saleItems     SaleItem[]
  transferItems StockTransferItem[]

  @@index([barcode])
  @@index([categoryId])
  @@index([isActive])
}

model Inventory {
  id        String  @id @default(cuid())
  productId String
  branchId  String
  quantity  Int     @default(0)
  minStock  Int     @default(5)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
}

model Customer {
  id            String   @id @default(cuid())
  name          String
  nameAr        String?
  email         String?
  phone         String?  @unique
  address       String?
  loyaltyPoints Int      @default(0)
  totalSpent    Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  sales         Sale[]

  @@index([phone])
}

model SaleItem {
  id              String  @id @default(cuid())
  saleId          String
  productId       String
  name            String
  nameAr          String?
  barcode         String?
  quantity        Int
  unitPrice       Float
  costPrice       Float   @default(0)
  discountAmount  Float   @default(0)
  discountPercent Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  total           Float
  profit          Float   @default(0)
  product         Product @relation(fields: [productId], references: [id])
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model StockTransfer {
  id           String              @id @default(cuid())
  fromBranchId String
  toBranchId   String
  status       StockTransferStatus @default(COMPLETED)
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())
  createdBy    User                @relation(fields: [createdById], references: [id])
  fromBranch   Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch     Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items        StockTransferItem[]

  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([createdAt])
}

model StockTransferItem {
  id              String        @id @default(cuid())
  stockTransferId String
  productId       String
  quantity        Int
  costPrice       Float         @default(0)
  product         Product       @relation(fields: [productId], references: [id])
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  @@index([stockTransferId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  amount    Float
  method    PaymentMethod
  notes     String?
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id])

  @@index([saleId])
}

model Expense {
  id            String   @id @default(cuid())
  branchId      String?
  title         String
  titleAr       String?
  amount        Float
  category      String
  paymentMethod String   @default("CASH")
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([branchId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  nameAr    String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String           @id @default(cuid())
  userId    String?
  type      NotificationType @default(INFO)
  title     String
  titleAr   String?
  message   String
  messageAr String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
}

enum SaleStatus {
  COMPLETED
  REFUNDED
  VOID
  PARTIAL
}

enum PaymentMethod {
  CASH
  CARD
  MOBILE
  QR
  SPLIT
  CREDIT
}

enum StockTransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK
  STOCK_TRANSFER
  NEW_SALE
  SYSTEM
  INFO
}
